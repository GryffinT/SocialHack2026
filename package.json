    "reagraph": "^4.32.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
